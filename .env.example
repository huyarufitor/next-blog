# Public canonical site URL. Must be an absolute HTTP(S) URL.
# Example: https://blog.example.com
NEXT_PUBLIC_SITE_URL=

# Giscus repository. Format: owner/repository
NEXT_PUBLIC_GISCUS_REPO=
# Repository ID copied from giscus.app. Usually starts with R_.
NEXT_PUBLIC_GISCUS_REPO_ID=
# Discussion category name copied from giscus.app.
NEXT_PUBLIC_GISCUS_CATEGORY=
# Discussion category ID copied from giscus.app. Usually starts with DIC_.
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
